# Base URL of the Harmonia backend API (no trailing slash).
# Obtain the real value from the backend team; do not commit a real .env.
VITE_API_BASE_URL=

# Dev-only: load labelled DEV FIXTURE data instead of calling the API (decision 0002).
# Ignored in production builds. Leave unset/false unless reviewing UI without a backend.
VITE_USE_DEV_FIXTURES=false

# OAuth client id (type Web) from Google Cloud Console for "Đăng nhập với Google". Leave empty to hide the button.
# The same id must be listed in the backend's Google__ClientIds, and this site's origin in the client's
# Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Dev-only: backend URL that `npm run dev` proxies /api to (vite.config.ts). Use it instead of
# VITE_API_BASE_URL when the backend does not allow the dev server origin in CORS.
API_PROXY_TARGET=
